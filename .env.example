# Copy to .env and fill in. Never commit .env.

# Twilio (console.twilio.com -> Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your public tunnel URL (from cloudflared), no trailing slash
PUBLIC_BASE_URL=

# Optional: enables reading shopping-list and nutrition-label photos
ANTHROPIC_API_KEY=

# Any long random string; used to scramble phone numbers before storing
POSHAN_SALT=
